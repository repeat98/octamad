# ------------------------------------------------------ hardware loops
# DO / DOR mark the loop's last word (LA) with context; the root table adds
# the loop-back there.  A zero count skips the loop.
instr: "do" MEAx6^","^LAabs is k23_14=0x19 & k7_7=0x0 & k5_0=0x0 & MEAx6 ; LAabs & LAend & LAval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LAabs, lbot); globalset(LAabs, lfor); globalset(LAabs, ltop); ]
	{ local n:3 = MEAx6; local top:3 = inst_next; doLoop(n, LAval, top); if (n != 0) goto inst_next; popLoop(); goto LAend; }
instr: "do" Maa6^","^LAabs is k23_14=0x18 & k7_7=0x0 & k5_0=0x0 & Maa6 ; LAabs & LAend & LAval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LAabs, lbot); globalset(LAabs, lfor); globalset(LAabs, ltop); ]
	{ local n:3 = Maa6; local top:3 = inst_next; doLoop(n, LAval, top); if (n != 0) goto inst_next; popLoop(); goto LAend; }
instr: "do" Cnt12^","^LAabs is k23_16=0x6 & k7_4=0x8 & Cnt12 ; LAabs & LAend & LAval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LAabs, lbot); globalset(LAabs, lfor); globalset(LAabs, ltop); ]
	{ local n:3 = Cnt12; local top:3 = inst_next; doLoop(n, LAval, top); if (n != 0) goto inst_next; popLoop(); goto LAend; }
instr: "do" R6nos^","^LAabs is k23_14=0x1b & k7_0=0x0 & R6nos ; LAabs & LAend & LAval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LAabs, lbot); globalset(LAabs, lfor); globalset(LAabs, ltop); ]
	{ local n:3 = R6nos; local top:3 = inst_next; doLoop(n, LAval, top); if (n != 0) goto inst_next; popLoop(); goto LAend; }
instr: "do" "forever,"^LAabs is k23_0=0x203 ; LAabs & LAval
	[ lbot=1; lfor=1; ltop=inst_start+2; globalset(LAabs, lbot); globalset(LAabs, lfor); globalset(LAabs, ltop); ]
	{ local top:3 = inst_next; doLoop(lc, LAval, top); }
instr: "dor" MEAx6^","^LArend is k23_14=0x19 & k7_7=0x0 & k5_0=0x10 & MEAx6 ; LArel & LArend & LArval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LArel, lbot); globalset(LArel, lfor); globalset(LArel, ltop); ]
	{ local n:3 = MEAx6; local top:3 = inst_next; doLoop(n, LArval, top); if (n != 0) goto inst_next; popLoop(); goto LArend; }
instr: "dor" Maa6^","^LArend is k23_14=0x18 & k7_7=0x0 & k5_0=0x10 & Maa6 ; LArel & LArend & LArval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LArel, lbot); globalset(LArel, lfor); globalset(LArel, ltop); ]
	{ local n:3 = Maa6; local top:3 = inst_next; doLoop(n, LArval, top); if (n != 0) goto inst_next; popLoop(); goto LArend; }
instr: "dor" Cnt12^","^LArend is k23_16=0x6 & k7_4=0x9 & Cnt12 ; LArel & LArend & LArval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LArel, lbot); globalset(LArel, lfor); globalset(LArel, ltop); ]
	{ local n:3 = Cnt12; local top:3 = inst_next; doLoop(n, LArval, top); if (n != 0) goto inst_next; popLoop(); goto LArend; }
instr: "dor" R6nos^","^LArend is k23_14=0x1b & k7_0=0x10 & R6nos ; LArel & LArend & LArval
	[ lbot=1; lfor=0; ltop=inst_start+2; globalset(LArel, lbot); globalset(LArel, lfor); globalset(LArel, ltop); ]
	{ local n:3 = R6nos; local top:3 = inst_next; doLoop(n, LArval, top); if (n != 0) goto inst_next; popLoop(); goto LArend; }
instr: "dor" "forever,"^LArend is k23_0=0x202 ; LArel & LArend & LArval
	[ lbot=1; lfor=1; ltop=inst_start+2; globalset(LArel, lbot); globalset(LArel, lfor); globalset(LArel, ltop); ]
	{ local top:3 = inst_next; doLoop(lc, LArval, top); }

instr: "enddo" is k23_7=0x1 & k5_5=0x0 & k3_0=0xc { popLoop(); }
instr: "brk"^CC0 is k23_4=0x21 & CC0 {
	if (!CC0) goto inst_next;
	local t:3 = la + 1;
	popLoop();
	goto [t];
}

# REP: repeat the next instruction LC times
instr: "rep" MEAx6 is k23_14=0x19 & k7_7=0x0 & k5_0=0x20 & MEAx6 [ rpt=1; globalset(inst_next, rpt); ] { rep_lc = lc; lc = MEAx6; }
instr: "rep" Maa6  is k23_14=0x18 & k7_7=0x0 & k5_0=0x20 & Maa6  [ rpt=1; globalset(inst_next, rpt); ] { rep_lc = lc; lc = Maa6; }
instr: "rep" Cnt12 is k23_16=0x6 & k7_7=0x1 & k5_5=0x1 & Cnt12 [ rpt=1; globalset(inst_next, rpt); ] { rep_lc = lc; lc = Cnt12; }
instr: "rep" R6r8  is k23_14=0x1b & k7_0=0x20 & R6r8  [ rpt=1; globalset(inst_next, rpt); ] { rep_lc = lc; lc = R6r8; }
# ================================================================ root table
:^instr is lbot=1 & lfor=0 & rpt=0 & LoopTop & instr {
	build instr;
	if (lc == 1) goto <done>;
	lc = lc - 1;
	goto LoopTop;
<done>
	lc = *[SS]:3 (ssp - 6);
	la = *[SS]:3 (ssp - 3);
	ssp = ssp - 12;
}

:^instr is lbot=1 & lfor=1 & rpt=0 & LoopTop & instr {
	build instr;
	goto LoopTop;
}

:^instr is rpt=1 & lbot=0 & instr {
	build instr;
	lc = lc - 1;
	if (lc != 0) goto inst_start;
	lc = rep_lc;
}

:^instr is instr { build instr; }

