CC12: "pl" is k15_12=0x3 { local c:1 = !N; export c; }
CC12: "nn" is k15_12=0x4 { local c:1 = Z || (!U && !E); export c; }
CC12: "ec" is k15_12=0x5 { local c:1 = !E; export c; }
CC12: "lc" is k15_12=0x6 { local c:1 = !L; export c; }
