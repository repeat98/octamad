
# ===================================================== non-parallel helpers
attach variables [ q4a ] [ x0 y0 x1 y1 x0 y0 x1 y1 x1 y1 x0 y0 y1 x0 y0 x1 ];
attach variables [ q4b ] [ x0 y0 x0 y0 y1 x0 y0 x1 x1 y1 x1 y1 x0 y0 x1 y1 ];
attach variables [ qq2 ] [ y1 x0 y0 x1 ];
attach variables [ jq4 ] [ x0 y0 x1 y1 ];

# peripheral operands with the pp/qq field in bits 5..0
Mpp16: "x:<<"^pa is k16_16=0 & k5_0 [ pa = 0xffffc0 + k5_0; ] { export *[X]:3 pa; }
Mpp16: "y:<<"^pa is k16_16=1 & k5_0 [ pa = 0xffffc0 + k5_0; ] { export *[Y]:3 pa; }
Mqqx0: "x:<<"^pa is k5_0 [ pa = 0xffff80 + k5_0; ] { export *[X]:3 pa; }
Mqqy0: "y:<<"^pa is k5_0 [ pa = 0xffff80 + k5_0; ] { export *[Y]:3 pa; }
Mqq6s: "x:<<"^pa is k6_6=0 & k5_0 [ pa = 0xffff80 + k5_0; ] { export *[X]:3 pa; }
Mqq6s: "y:<<"^pa is k6_6=1 & k5_0 [ pa = 0xffff80 + k5_0; ] { export *[Y]:3 pa; }
MqqXs: "x:<<"^pa is k6_6 & k4_0 [ pa = 0xffff80 + (k6_6 << 5) + k4_0; ] { export *[X]:3 pa; }
MqqYs: "y:<<"^pa is k6_6 & k4_0 [ pa = 0xffff80 + (k6_6 << 5) + k4_0; ] { export *[Y]:3 pa; }
PEA:   "p:"^EA is EA { export *[P]:3 EA; }
Paa:   "p:<"^k13_8 is k13_8 { export *[P]:3 k13_8; }

# loop end operands: export the last word of the loop (LA), display LA+1
LAabs: lp1 is ext24 [ lp1 = ext24 + 1; ] { export *[P]:3 ext24; }
LAend: lp1 is ext24 [ lp1 = ext24 + 1; ] { export *[P]:3 lp1; }
LArel: lad is sext24 [ lad = inst_start + sext24; ] { export *[P]:3 lad; }
LArend: lp1 is sext24 [ lp1 = inst_start + sext24 + 1; ] { export *[P]:3 lp1; }
LAval: is ext24 { export *[const]:3 ext24; }
LArval: lad is sext24 [ lad = inst_start + sext24; ] { export *[const]:3 lad; }

# 12-bit loop / repeat count: hhhh (3..0) : iiiiiiii (15..8)
Cnt12: "#"^cnt is k3_0 & k15_8 [ cnt = (k3_0 << 8) | k15_8; ] { export *[const]:3 cnt; }

# 6-bit and 5-bit bit numbers
BitN: "#"^k4_0 is k4_4=0 & k4_0 { local bitv:3 = 1 << k4_0; export bitv; }
BitN: "#"^k4_0 is k4_3=2 & k4_0 { local bitv:3 = 1 << k4_0; export bitv; }

# accumulator source for the ALU forms that name a second 24-bit operand
ACT3: "a1" is k3_1=2 { export a1; }
ACT3: "b1" is k3_1=3 { export b1; }
ACT3: "x0" is k3_1=4 { export x0; }
ACT3: "y0" is k3_1=5 { export y0; }
ACT3: "x1" is k3_1=6 { export x1; }
ACT3: "y1" is k3_1=7 { export y1; }

# Tcc first source
TccS: nacc3 is k6_4=0 & nacc3 { export nacc3; }
TccS: S56j  is k6_6=1 & S56j  { export S56j; }

macro push(hi, lo) {
	ssp = ssp + 6;
	*[SS]:3 (ssp + 3) = hi;
	*[SS]:3 ssp = lo;
}

macro jsrTo(dest) {
	local ret:3 = inst_next;
	push(ret, sr);
	call dest;
}

macro doLoop(cnt, lastword, top) {
	push(la, lc);
	push(top, sr);
	la = lastword;
	lc = cnt;
}

macro popLoop() {
	lc = *[SS]:3 (ssp - 6);
	la = *[SS]:3 (ssp - 3);
	ssp = ssp - 12;
}

# ============================================================ instructions
instr: "nop" is {000000000000000000000000} { }
instr: "rts" is {000000000000000000001100} {
	local ra:3 = *[SS]:3 (ssp + 3);
	ssp = ssp - 6;
	return [ra];
}
instr: "rti" is {000000000000000000000100} {
	local ra:3 = *[SS]:3 (ssp + 3);
	local s:3 = *[SS]:3 ssp;
	ssp = ssp - 6;
	unpackSR(s);
	return [ra];
}
instr: "illegal" is {000000000000000000000101} { illegal_instruction(); }
instr: "trap"    is {000000000000000000000110} { software_interrupt(); }
instr: "trap"^CC0 is {00000000000000000001????} & CC0 { if (!CC0) goto inst_next; software_interrupt(); }
instr: "debug"   is {000000000000001000000000} { debug_request(); }
instr: "debug"^CC0 is {00000000000000110000????} & CC0 { if (!CC0) goto inst_next; debug_request(); }
instr: "pflush"   is {000000000000000000000011} { cache_control(); }
instr: "pflushun" is {000000000000000000000001} { cache_control(); }
instr: "pfree"    is {000000000000000000000010} { cache_control(); }
instr: "reset"    is {00000000000000001?0?0100} { reset_peripherals(); }
instr: "stop"     is {00000000000000001?0?0111} { halt_stop(); }
instr: "wait"     is {00000000000000001?0?0110} { halt_wait(); }
instr: "plockr" Rel24   is {000000000000000000001111} ; Rel24 { cache_control(); }
instr: "punlockr" Rel24 is {000000000000000000001110} ; Rel24 { cache_control(); }
instr: "plock" EA   is ({0000101111??????10000001}) ... & EA { cache_control(); }
instr: "punlock" EA is ({0000101011??????10000001}) ... & EA { cache_control(); }

instr: "dec" acc0 is {00000000000000000000101?} & acc0 { local o:7 = acc0; sub56(o, 1:7); acc0 = alu_r; }
instr: "inc" acc0 is {00000000000000000000100?} & acc0 { local o:7 = acc0; add56(o, 1:7); acc0 = alu_r; }

# AND(I) / OR(I) on mr, ccr, com, eom
instr: "andi" "#"^k15_8^",mr"  is {00000000????????10111000} & k15_8 { sr = sr & ((k15_8 << 8) | 0xff00ff); }
instr: "andi" "#"^k15_8^",ccr" is {00000000????????10111001} & k15_8 { local v:3 = 0; packSR(v); v = v & (0xffff00 | k15_8); unpackCCR(v); }
instr: "andi" "#"^k15_8^",com" is {00000000????????10111010} & k15_8 { omr = omr & (0xffff00 | k15_8); }
instr: "andi" "#"^k15_8^",eom" is {00000000????????10111011} & k15_8 { omr = omr & ((k15_8 << 8) | 0xff00ff); }
instr: "ori" "#"^k15_8^",mr"   is {00000000????????11111000} & k15_8 { sr = sr | (k15_8 << 8); }
instr: "ori" "#"^k15_8^",ccr"  is {00000000????????11111001} & k15_8 { local v:3 = 0; packSR(v); v = v | k15_8; unpackCCR(v); }
instr: "ori" "#"^k15_8^",com"  is {00000000????????11111010} & k15_8 { omr = omr | k15_8; }
instr: "ori" "#"^k15_8^",eom"  is {00000000????????11111011} & k15_8 { omr = omr | (k15_8 << 8); }

# ------------------------------------------------------------ immediate ALU
instr: "add" "#"^k13_8^","^acc3 is {0000000101??????10???000} & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; add56(acc3, s); acc3 = alu_r; }
instr: "sub" "#"^k13_8^","^acc3 is {0000000101??????10???100} & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; sub56(acc3, s); acc3 = alu_r; }
instr: "cmp" "#"^k13_8^","^acc3 is {0000000101??????10???101} & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; sub56(acc3, s); }
instr: "and" "#"^k13_8^","^acc3 is {0000000101??????10???110} & k13_8 & acc3 { local r:3 = acc3[24,24] & k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "or"  "#"^k13_8^","^acc3 is {0000000101??????10???010} & k13_8 & acc3 { local r:3 = acc3[24,24] | k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "eor" "#"^k13_8^","^acc3 is {0000000101??????10???011} & k13_8 & acc3 { local r:3 = acc3[24,24] ^ k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "add" "#>"^ext24^","^acc3 is {0000000101??????11???000} & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; add56(acc3, s); acc3 = alu_r; }
instr: "sub" "#>"^ext24^","^acc3 is {0000000101??????11???100} & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; sub56(acc3, s); acc3 = alu_r; }
instr: "cmp" "#>"^ext24^","^acc3 is {0000000101??????11???101} & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; sub56(acc3, s); }
instr: "and" "#>"^ext24^","^acc3 is {0000000101??????11???110} & acc3 ; ext24 { local r:3 = acc3[24,24] & ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "or"  "#>"^ext24^","^acc3 is {0000000101??????11???010} & acc3 ; ext24 { local r:3 = acc3[24,24] | ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "eor" "#>"^ext24^","^acc3 is {0000000101??????11???011} & acc3 ; ext24 { local r:3 = acc3[24,24] ^ ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }

# ----------------------------------------------------------- multiplies
# (+/-)S,#n,D : S * 2^-n
instr: "mpy"  qq2^",#"^k12_8^","^acc3      is {00000001000?????11???000} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpy"  "-"^qq2^",#"^k12_8^","^acc3  is {00000001000?????11???100} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = -p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyr" qq2^",#"^k12_8^","^acc3      is {00000001000?????11???001} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyr" "-"^qq2^",#"^k12_8^","^acc3  is {00000001000?????11???101} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = -((p << 24) s>> k12_8); alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mac"  qq2^",#"^k12_8^","^acc3      is {00000001000?????11???010} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; add56(acc3, p); acc3 = alu_r; }
instr: "mac"  "-"^qq2^",#"^k12_8^","^acc3  is {00000001000?????11???110} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; sub56(acc3, p); acc3 = alu_r; }
instr: "macr" qq2^",#"^k12_8^","^acc3      is {00000001000?????11???011} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; add56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }
instr: "macr" "-"^qq2^",#"^k12_8^","^acc3  is {00000001000?????11???111} & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; sub56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }

# (+/-)#xxxx,S,D
MImm: "#>"^ext24 is ext24 { local p:7 = sext(ext24:3); export p; }
instr: "mpyi"  MImm^","^jq4^","^acc3     is {0000000101?????111???000} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyi"  "-"^MImm^","^jq4^","^acc3 is {0000000101?????111???100} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = -p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyri" MImm^","^jq4^","^acc3     is {0000000101?????111???001} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyri" "-"^MImm^","^jq4^","^acc3 is {0000000101?????111???101} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; p = -p; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "maci"  MImm^","^jq4^","^acc3     is {0000000101?????111???010} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; add56(acc3, p); acc3 = alu_r; }
instr: "maci"  "-"^MImm^","^jq4^","^acc3 is {0000000101?????111???110} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; sub56(acc3, p); acc3 = alu_r; }
instr: "macri" MImm^","^jq4^","^acc3     is {0000000101?????111???011} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; add56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }
instr: "macri" "-"^MImm^","^jq4^","^acc3 is {0000000101?????111???111} & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; sub56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }

# signed x unsigned / unsigned x unsigned; QQQQ operand pairs in bits 3..0
QSU: q4a^","^q4b is q4a & q4b { local p:7 = (sext(q4a) * zext(q4b)) << 1; export p; }
QUU: q4a^","^q4b is q4a & q4b { local p:7 = (zext(q4a) * zext(q4b)) << 1; export p; }
QSS: q4a^","^q4b is q4a & q4b { local p:7 = (sext(q4a) * sext(q4b)) << 1; export p; }
instr: "macsu" QSU^","^acc5     is {00000001001001101 0?0????} & QSU & acc5 { add56(acc5, QSU); acc5 = alu_r; }
instr: "macsu" "-"^QSU^","^acc5 is {00000001001001101 0?1????} & QSU & acc5 { sub56(acc5, QSU); acc5 = alu_r; }
instr: "macuu" QUU^","^acc5     is {00000001001001101 1?0????} & QUU & acc5 { add56(acc5, QUU); acc5 = alu_r; }
instr: "macuu" "-"^QUU^","^acc5 is {00000001001001101 1?1????} & QUU & acc5 { sub56(acc5, QUU); acc5 = alu_r; }
instr: "mpysu" QSU^","^acc5     is {00000001001001111 0?0????} & QSU & acc5 { alu_r = QSU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpysu" "-"^QSU^","^acc5 is {00000001001001111 0?1????} & QSU & acc5 { alu_r = -QSU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpyuu" QUU^","^acc5     is {00000001001001111 1?0????} & QUU & acc5 { alu_r = QUU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpyuu" "-"^QUU^","^acc5 is {00000001001001111 1?1????} & QUU & acc5 { alu_r = -QUU; V = 0; nzeu(alu_r); acc5 = alu_r; }
# DMAC: acc = (acc >> 24) +/- s1*s2
instr: "dmacss" QSS^","^acc5     is {000000010010010 0 1 0 ? 0 ????} & QSS & acc5 { local d:7 = acc5 s>> 24; add56(d, QSS); acc5 = alu_r; }
instr: "dmacss" "-"^QSS^","^acc5 is {000000010010010 0 1 0 ? 1 ????} & QSS & acc5 { local d:7 = acc5 s>> 24; sub56(d, QSS); acc5 = alu_r; }
instr: "dmacsu" QSU^","^acc5     is {000000010010010 1 1 0 ? 0 ????} & QSU & acc5 { local d:7 = acc5 s>> 24; add56(d, QSU); acc5 = alu_r; }
instr: "dmacsu" "-"^QSU^","^acc5 is {000000010010010 1 1 0 ? 1 ????} & QSU & acc5 { local d:7 = acc5 s>> 24; sub56(d, QSU); acc5 = alu_r; }
instr: "dmacuu" QUU^","^acc5     is {000000010010010 1 1 1 ? 0 ????} & QUU & acc5 { local d:7 = acc5 s>> 24; add56(d, QUU); acc5 = alu_r; }
instr: "dmacuu" "-"^QUU^","^acc5 is {000000010010010 1 1 1 ? 1 ????} & QUU & acc5 { local d:7 = acc5 s>> 24; sub56(d, QUU); acc5 = alu_r; }

# ---------------------------------------------------- other data ALU ops
instr: "div" jj4^","^acc3 is {000000011000000001???000} & jj4 & acc3 { acc3 = div_step(acc3, jj4, C); C = acc3 s>= 0; V = 0; }
instr: "norm" ea_r^","^acc3 is {0000000111011???0001?101} & ea_r & acc3 { acc3 = norm_step(acc3, ea_r); ea_r = norm_step(acc3, ea_r); }
instr: "normf" ACT3^","^acc0 is {00001100000111100010????} & ACT3 & acc0 { acc0 = normf(acc0, ACT3); nzeu(acc0); }
instr: "clb" acc1^","^acc0 is {0000110000011110000000??} & acc1 & acc0 { local n:3 = clb(acc1); fr56(acc0, n); nzeu(acc0); }
instr: "cmpu" nacc0^","^acc0 is {00001100000111111111000?} & nacc0 & acc0 { C = acc0 < nacc0; Z = acc0 == nacc0; N = 0; V = 0; }
instr: "cmpu" ACT3^","^acc0  is {00001100000111111111????} & k3_3=1 & ACT3 & acc0 { local s:7 = zext(ACT3) << 24; local d:7 = acc0 & 0xffffffffffff; C = d < s; Z = d == s; N = 0; V = 0; }

instr: "asl" "#"^k6_1^","^acc7^","^acc0 is {0000110000011101????????} & k6_1 & acc7 & acc0 {
	local n:7 = k6_1; local r:7 = acc7 << n; C = n != 0 && ((acc7 >> (56 - n)) & 1) != 0;
	V = (r s>> n) != acc7; L = L || V; acc0 = r; nzeu(r);
}
instr: "asr" "#"^k6_1^","^acc7^","^acc0 is {0000110000011100????????} & k6_1 & acc7 & acc0 {
	local n:7 = k6_1; C = n != 0 && ((acc7 >> (n - 1)) & 1) != 0;
	local r:7 = acc7 s>> n; V = 0; acc0 = r; nzeu(r);
}
instr: "asl" ACT3^","^acc4^","^acc0 is {0000110000011110010?????} & ACT3 & acc4 & acc0 {
	local n:7 = zext(ACT3 & 0x3f); local r:7 = acc4 << n; V = (r s>> n) != acc4; L = L || V; acc0 = r; nzeu(r);
}
instr: "asr" ACT3^","^acc4^","^acc0 is {0000110000011110011?????} & ACT3 & acc4 & acc0 {
	local n:7 = zext(ACT3 & 0x3f); local r:7 = acc4 s>> n; V = 0; acc0 = r; nzeu(r);
}
instr: "lsl" "#"^k5_1^","^acc0 is {000011000001111010??????} & k5_1 & acc0 { local r:3 = acc0[24,24] << k5_1; setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsr" "#"^k5_1^","^acc0 is {000011000001111011??????} & k5_1 & acc0 { local r:3 = acc0[24,24] >> k5_1; setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsl" ACT3^","^acc0 is {00001100000111100001????} & ACT3 & acc0 { local r:3 = acc0[24,24] << (ACT3 & 0x1f); setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsr" ACT3^","^acc0 is {00001100000111100011????} & ACT3 & acc0 { local r:3 = acc0[24,24] >> (ACT3 & 0x1f); setd1(acc0, r); acc0 = alu_r; nz24(r); }

# bit-field operations; control word: width in bits 17..12, offset in bits 5..0
macro bfextract(src, ctl, dst, signed) {
	local w:7 = zext((ctl >> 12) & 0x3f);
	local o:7 = zext(ctl & 0x3f);
	local f:7 = (src >> o) & ((1 << w) - 1);
	local s:7 = (f << (56 - w)) s>> (56 - w);
	dst = f;
	if (signed == 0) goto <done>;
	dst = s;
<done>
	nzeu(dst);
}
instr: "extract" ACT3^","^acc4^","^acc0  is {0000110000011010000?????} & ACT3 & acc4 & acc0 { bfextract(acc4, ACT3, acc0, 1:1); }
instr: "extractu" ACT3^","^acc4^","^acc0 is {0000110000011010100?????} & ACT3 & acc4 & acc0 { bfextract(acc4, ACT3, acc0, 0:1); }
instr: "extract" "#>"^ext24^","^acc4^","^acc0  is {0000110000011000000?000?} & acc4 & acc0 ; ext24 { local c:3 = ext24; bfextract(acc4, c, acc0, 1:1); }
instr: "extractu" "#>"^ext24^","^acc4^","^acc0 is {0000110000011000100?000?} & acc4 & acc0 ; ext24 { local c:3 = ext24; bfextract(acc4, c, acc0, 0:1); }
INS3: "a0" is k6_4=2 { export a0; }
INS3: "b0" is k6_4=3 { export b0; }
INS3: "x0" is k6_4=4 { export x0; }
INS3: "y0" is k6_4=5 { export y0; }
INS3: "x1" is k6_4=6 { export x1; }
INS3: "y1" is k6_4=7 { export y1; }
macro bfinsert(src, ctl, dst) {
	local w:7 = zext((ctl >> 12) & 0x3f);
	local o:7 = zext(ctl & 0x3f);
	local m:7 = ((1 << w) - 1) << o;
	dst = (dst & ~m) | ((zext(src) << o) & m);
	nzeu(dst);
}
instr: "insert" ACT3^","^INS3^","^acc0 is {00001100000110110???????} & ACT3 & INS3 & acc0 { bfinsert(INS3, ACT3, acc0); }
instr: "insert" "#>"^ext24^","^INS3^","^acc0 is {00001100000110010???000?} & INS3 & acc0 ; ext24 { local c:3 = ext24; bfinsert(INS3, c, acc0); }
instr: "merge" ACT3^","^acc0 is {00001100000110111000????} & ACT3 & acc0 { local r:3 = (ACT3 << 12) | (acc0[24,24] & 0xfff); setd1(acc0, r); acc0 = alu_r; nz24(r); }

# conditional transfers
instr: "t"^CC12 TccS^","^acc3 is {00000010????0???0???????} & CC12 & TccS & acc3 { if (!CC12) goto inst_next; acc3 = TccS; }
instr: "t"^CC12 TccS^","^acc3^" "^ea_r^","^t_r0 is {00000011????0???0???????} & CC12 & TccS & acc3 & ea_r & t_r0 { if (!CC12) goto inst_next; local s:3 = ea_r; acc3 = TccS; t_r0 = s; }
