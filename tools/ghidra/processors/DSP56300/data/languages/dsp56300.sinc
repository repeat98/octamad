# VSL: A1/B1 -> X:ea, A0/B0 shifted left with bit i -> Y:ea
instr: "vsl" acc16^","^k4_4^",l:"^EA is (k23_17=0x5 & k15_14=0x3 & k7_5=0x6 & k3_0=0x0 & acc16 & k4_4) ... & EA {
	local ad:3 = EA; *[X]:3 ad = acc16[24,24]; *[Y]:3 ad = (acc16:3 << 1) | k4_4;
}

# --------------------------------------------------------- bit manipulation
macro bittest(v, bit) { C = (v & bit) != 0; }
instr: "bclr" BitN^","^MEA6 is (k23_14=0x29 & k7_7=0x0 & k5_5=0x0 & BitN) ... & MEA6 { local v:3 = MEA6; bittest(v, BitN); MEA6 = v & ~BitN; }
