instr: "lra" Rel24^","^R5w0 is {0000010001??????010?????} & R5w0 ; Rel24 & sext24 { mv1 = inst_start + sext24; build R5w0; }

# ----------------------------------------------------------- moves (np)
# X:(Rn+xxxx) / Y:(Rn+xxxx), long displacement
LDisp24: "+"^sext24 is sext24 & k23_23e=0 { export *[const]:3 sext24; }
LDisp24: "-"^nd is sext24 & k23_23e=1 [ nd = -sext24; ] { export *[const]:3 sext24; }
instr: "move" "x:("^ea_r^LDisp24^"),"^R6w0 is {0000101001110???11??????} & ea_r & R6w0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; mv1 = *[X]:3 ad; build R6w0; }
instr: "move" R6r0^",x:("^ea_r^LDisp24^")" is {0000101001110???10??????} & ea_r & R6r0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; *[X]:3 ad = R6r0; }
instr: "move" "y:("^ea_r^LDisp24^"),"^R6w0 is {0000101101110???11??????} & ea_r & R6w0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; mv1 = *[Y]:3 ad; build R6w0; }
instr: "move" R6r0^",y:("^ea_r^LDisp24^")" is {0000101101110???10??????} & ea_r & R6r0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; *[Y]:3 ad = R6r0; }
# X:(Rn+xxx) / Y:(Rn+xxx), 7-bit displacement split over bits 16..11 and 6
Disp7: "+"^disp is s16_16=0 & s16_11 & k6_6 [ disp = (s16_11 << 1) | k6_6; ] { export *[const]:3 disp; }
Disp7: "-"^ndisp is s16_16=1 & s16_11 & k6_6 [ ndisp = -((s16_11 << 1) | k6_6); ] { local d:3 = -ndisp; export d; }
instr: "move" "x:("^ea_r^Disp7^"),"^D4w0 is {0000001?????????1?01????} & ea_r & Disp7 & D4w0 { local ad:3 = ea_r + Disp7; mv1 = *[X]:3 ad; build D4w0; }
instr: "move" D4r0^",x:("^ea_r^Disp7^")" is {0000001?????????1?00????} & ea_r & Disp7 & D4r0 { local ad:3 = ea_r + Disp7; *[X]:3 ad = D4r0; }
instr: "move" "y:("^ea_r^Disp7^"),"^D4w0 is {0000001?????????1?11????} & ea_r & Disp7 & D4w0 { local ad:3 = ea_r + Disp7; mv1 = *[Y]:3 ad; build D4w0; }
instr: "move" D4r0^",y:("^ea_r^Disp7^")" is {0000001?????????1?10????} & ea_r & Disp7 & D4r0 { local ad:3 = ea_r + Disp7; *[Y]:3 ad = D4r0; }

