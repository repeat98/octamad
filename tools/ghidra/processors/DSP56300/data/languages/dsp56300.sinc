CC0: "cc" is k3_0=0x0 { local c:1 = !C; export c; }
CC0: "ge" is k3_0=0x1 { local c:1 = N == V; export c; }
CC0: "ne" is k3_0=0x2 { local c:1 = !Z; export c; }
CC0: "pl" is k3_0=0x3 { local c:1 = !N; export c; }
CC0: "nn" is k3_0=0x4 { local c:1 = Z || (!U && !E); export c; }
CC0: "ec" is k3_0=0x5 { local c:1 = !E; export c; }
CC0: "lc" is k3_0=0x6 { local c:1 = !L; export c; }
CC0: "gt" is k3_0=0x7 { local c:1 = !Z && (N == V); export c; }
CC0: "cs" is k3_0=0x8 { local c:1 = C; export c; }
CC0: "lt" is k3_0=0x9 { local c:1 = N != V; export c; }
CC0: "eq" is k3_0=0xa { local c:1 = Z; export c; }
CC0: "mi" is k3_0=0xb { local c:1 = N; export c; }
CC0: "nr" is k3_0=0xc { local c:1 = !Z && (U || E); export c; }
CC0: "es" is k3_0=0xd { local c:1 = E; export c; }
CC0: "ls" is k3_0=0xe { local c:1 = L; export c; }
CC0: "le" is k3_0=0xf { local c:1 = Z || (N != V); export c; }
