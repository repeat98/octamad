diff --git a/Ghidra/Processors/68000/data/languages/coldfire.cspec b/Ghidra/Processors/68000/data/languages/coldfire.cspec
new file mode 100644
index 0000000000..ea70d1bfd0
--- /dev/null
+++ b/Ghidra/Processors/68000/data/languages/coldfire.cspec
@@ -0,0 +1,83 @@
+<?xml version="1.0" encoding="UTF-8"?>
+
+<!--
+  GCC calling convention for ColdFire (m68k-elf / uClinux style, no FPU):
+    - all arguments on the stack (4-byte slots, first argument at 4(SP))
+    - integer/pointer/float results in D0, 64-bit results (long long, double) in D0:D1
+    - no FP register results: ColdFire parts without an FPU return floating point in D0/D0:D1
+    - D0, D1, A0, A1 are scratch; D2-D7, A2-A6 are preserved
+  Pointers are returned in D0 only (callers copy D0 to an address register); the
+  68000 SVR4 convention of also returning pointers in A0 is not used by GCC for ColdFire.
+-->
+<compiler_spec>
+  <data_organization>
+	<absolute_max_alignment value="0" />
+	<machine_alignment value="8" />
+	<default_alignment value="1" />
+	<default_pointer_alignment value="4" />
+	<pointer_size value="4" />
+	<wchar_size value="4" />
+	<short_size value="2" />
+	<integer_size value="4" />
+	<long_size value="4" />
+	<long_long_size value="8" />
+	<float_size value="4" />
+	<double_size value="8" />
+	<long_double_size value="8" />
+	<size_alignment_map>
+		<entry size="1" alignment="1" />
+		<entry size="2" alignment="2" />
+		<entry size="4" alignment="4" />
+		<entry size="8" alignment="4" />
+	</size_alignment_map>
+  </data_organization>
+
+  <global>
+    <range space="ram"/>
+  </global>
+
+  <stackpointer register="SP" space="ram"/>
+
+  <returnaddress>
+    <varnode space="stack" offset="0" size="4"/>
+  </returnaddress>
+
+  <default_proto>
+    <prototype name="__stdcall" extrapop="4" stackshift="4">
+      <input>
+        <pentry minsize="1" maxsize="500" align="4">
+          <addr offset="4" space="stack"/>
+        </pentry>
+      </input>
+      <output>
+        <pentry minsize="1" maxsize="4">
+          <register name="D0" />
+        </pentry>
+        <pentry minsize="5" maxsize="8">
+          <addr space="join" piece1="D0" piece2="D1"/>
+        </pentry>
+      </output>
+      <unaffected>
+        <register name="D2"/>
+        <register name="D3"/>
+        <register name="D4"/>
+        <register name="D5"/>
+        <register name="D6"/>
+        <register name="D7"/>
+        <register name="A2"/>
+        <register name="A3"/>
+        <register name="A4"/>
+        <register name="A5"/>
+        <register name="A6"/>
+        <register name="SP"/>
+      </unaffected>
+      <killedbycall>
+        <register name="D0"/>
+        <register name="D1"/>
+        <register name="A0"/>
+        <register name="A1"/>
+      </killedbycall>
+    </prototype>
+  </default_proto>
+
+</compiler_spec>
diff --git a/Ghidra/Processors/68000/data/languages/coldfire_emacfrac.pspec b/Ghidra/Processors/68000/data/languages/coldfire_emacfrac.pspec
new file mode 100644
index 0000000000..0d5f27ddc3
--- /dev/null
+++ b/Ghidra/Processors/68000/data/languages/coldfire_emacfrac.pspec
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="UTF-8"?>
+
+<!--
+  ColdFire with the EMAC unit assumed to run in fractional mode (MACSR[F/I]=1),
+  e.g. DSP-style firmware that sets MACSR to 0x20. Selects the fractional EMAC
+  semantics of coldfire.sla for the whole program (see the EMAC section of 68000.sinc).
+  Individual ranges can still be switched with the emacFrac / emacRnd16 context
+  registers (Set Register Values), e.g. emacRnd16=1 where MACSR[S/U]=1.
+-->
+<processor_spec>
+  <properties>
+    <property key="emulateInstructionStateModifierClass" value="ghidra.program.emulation.m68kEmulateInstructionStateModifier"/>
+    <property key="useropLibs" value="m68k,trig"/>
+  </properties>
+  <programcounter register="PC"/>
+  <context_data>
+    <context_set space="ram">
+      <set name="emacFrac" val="1" description="EMAC fractional mode (MACSR F/I=1)"/>
+    </context_set>
+  </context_data>
+</processor_spec>
