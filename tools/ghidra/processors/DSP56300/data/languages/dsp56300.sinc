instr: "bs"^CC0 Rel24 is k23_4=0xd100 & CC0 ; Rel24 { if (!CC0) goto inst_next; jsrTo(Rel24); }
instr: "bs"^CC12 Rel9 is k23_16=0x5 & k11_10=0x0 & k5_5=0x0 & CC12 & Rel9 { if (!CC12) goto inst_next; jsrTo(Rel9); }
instr: "bs"^CC0 ea_r  is k23_11=0x1a3 & k7_4=0x0 & CC0 & ea_r { if (!CC0) goto inst_next; local t:3 = inst_start + ea_r; local ret:3 = inst_next; push(ret, sr); call [t]; }

instr: "jmp" Abs12 is k23_12=0xc0 & Abs12 { goto Abs12; }
instr: "jmp" Abs24 is k23_0=0xaf080 ; Abs24 { goto Abs24; }
