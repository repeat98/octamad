# VSL: A1/B1 -> X:ea, A0/B0 shifted left with bit i -> Y:ea
instr: "vsl" acc16^","^k4_4^",l:"^EA is ({0000101?11??????110?0000} & acc16 & k4_4) ... & EA {
	local ad:3 = EA; *[X]:3 ad = acc16[24,24]; *[Y]:3 ad = (acc16:3 << 1) | k4_4;
}

# --------------------------------------------------------- bit manipulation
macro bittest(v, bit) { C = (v & bit) != 0; }
instr: "bclr" BitN^","^MEA6 is ({0000101001??????0?0?????} & BitN) ... & MEA6 { local v:3 = MEA6; bittest(v, BitN); MEA6 = v & ~BitN; }
