+	void DspPair::enableWordMap()
+	{
+		m_a1On = true;
+		for(size_t i = 0; i < m_cores.size(); ++i)
+		{
+			Core& c = *m_cores[i];
+			for(int a = 0; a < 3; ++a)
+			{
+				c.a1Flags[a].assign(0x40000, 0);
+				c.a1LastW[a].assign(0x40000, 0); c.a1LastR[a].assign(0x40000, 0); c.a1LastRB[a].assign(0x40000, 0);
+				c.a1W[a].assign(0x40000, 0); c.a1R[a].assign(0x40000, 0); c.a1RB[a].assign(0x40000, 0);
+			}
+			Core* cp = &c;
+			c.mem->m_readHookA1 = [this, cp](const dsp56k::EMemArea _area, const dsp56k::TWord _off)
+			{
+				if(_off >= 0x40000)
+					return;
+				Core& k = *cp;
+				const int ar = _area == dsp56k::MemArea_X ? 0 : _area == dsp56k::MemArea_Y ? 1 : 2;
+				const uint32_t e = k.a1Epoch + 1;
+				if(k.a1LastR[ar][_off] != e) { k.a1LastR[ar][_off] = e; if(k.a1R[ar][_off] < 0xffff) ++k.a1R[ar][_off]; }
+				k.a1Flags[ar][_off] |= k.a1Epoch ? 16 : 8;
+				if(k.a1Epoch && k.a1LastW[ar][_off] != e && k.a1LastRB[ar][_off] != e)
+				{
+					k.a1LastRB[ar][_off] = e;
+					if(k.a1RB[ar][_off] < 0xffff) ++k.a1RB[ar][_off];
+				}
+			};
+		}
 	}
+	void DspPair::writeWordMap(const std::string& _file) const
+	{
+		FILE* f = std::fopen(_file.c_str(), "wb");
+		if(!f) return;
+		const uint32_t hdr[4] = {0x41314d50, static_cast<uint32_t>(m_cores.size()), m_cores[0]->a1Epoch, m_cores.size() > 1 ? m_cores[1]->a1Epoch : 0};
+		std::fwrite(hdr, 4, 4, f);
+		for(auto& cp : m_cores)
+			for(int a = 0; a < 3; ++a)
+			{
+				std::fwrite(cp->a1Flags[a].data(), 1, 0x40000, f);
+				std::fwrite(cp->a1W[a].data(), 2, 0x40000, f);
+				std::fwrite(cp->a1R[a].data(), 2, 0x40000, f);
+				std::fwrite(cp->a1RB[a].data(), 2, 0x40000, f);
+			}
+		std::fclose(f);
+	}
 }
