# ---------------------------------------------------------- flow control
instr: "bra" Rel24  is k23_0=0xd10c0 ; Rel24 { goto Rel24; }
instr: "bra" Rel9   is k23_10=0x143 & k5_5=0x0 & Rel9 { goto Rel9; }
instr: "bra" ea_r   is k23_11=0x1a3 & k7_0=0xc0 & ea_r { local t:3 = inst_start + ea_r; goto [t]; }
instr: "bsr" Rel24  is k23_0=0xd1080 ; Rel24 { jsrTo(Rel24); }
instr: "bsr" Rel9   is k23_10=0x142 & k5_5=0x0 & Rel9 { jsrTo(Rel9); }
instr: "bsr" ea_r   is k23_11=0x1a3 & k7_0=0x80 & ea_r { local t:3 = inst_start + ea_r; local ret:3 = inst_next; push(ret, sr); call [t]; }
instr: "b"^CC0 Rel24  is k23_4=0xd104 & CC0 ; Rel24 { if (CC0) goto Rel24; }
instr: "b"^CC12 Rel9  is k23_16=0x5 & k11_10=0x1 & k5_5=0x0 & CC12 & Rel9 { if (CC12) goto Rel9; }
