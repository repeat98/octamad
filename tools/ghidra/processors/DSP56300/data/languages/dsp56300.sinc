# ------------------------------------------------------------ flow targets
Rel24: dest is sext24 [ dest = inst_start + sext24; ] { export *[P]:3 dest; }
Abs24: ext24 is ext24 { export *[P]:3 ext24; }
Rel9:  dest is s9_6 & k4_0 [ dest = inst_start + ((s9_6 << 5) | k4_0); ] { export *[P]:3 dest; }
Abs12: k11_0 is k11_0 { export *[P]:3 k11_0; }

LoopTop: ltop is ltop { export *[P]:3 ltop; }

# ================================================================== data ALU
# Multiplier input pairs QQQ (bits 6..4); the product is fractional: (s1*s2)<<1
MulQ: "x0,x0" is k6_4=0 { local p:7 = sext(x0) * sext(x0); p = p << 1; export p; }
MulQ: "y0,y0" is k6_4=1 { local p:7 = sext(y0) * sext(y0); p = p << 1; export p; }
MulQ: "x1,x0" is k6_4=2 { local p:7 = sext(x1) * sext(x0); p = p << 1; export p; }
MulQ: "y1,y0" is k6_4=3 { local p:7 = sext(y1) * sext(y0); p = p << 1; export p; }
MulQ: "x0,y1" is k6_4=4 { local p:7 = sext(x0) * sext(y1); p = p << 1; export p; }
MulQ: "y0,x0" is k6_4=5 { local p:7 = sext(y0) * sext(x0); p = p << 1; export p; }
MulQ: "x1,y0" is k6_4=6 { local p:7 = sext(x1) * sext(y0); p = p << 1; export p; }
MulQ: "y1,x1" is k6_4=7 { local p:7 = sext(y1) * sext(x1); p = p << 1; export p; }

# Source 24-bit operand aligned as a 56-bit accumulator value
S56j: jj4 is jj4 { local t:7 = sext(jj4); t = t << 24; export t; }
S48:  xy4 is xy4 { local t:7 = sext(xy4); export t; }

macro add56(d, s) {
	alu_r = d + s;
	C = carry(d, s);
	V = scarry(d, s);
	L = L || V;
	nzeu(alu_r);
}

macro sub56(d, s) {
	alu_r = d - s;
	C = d < s;
	V = sborrow(d, s);
	L = L || V;
	nzeu(alu_r);
}

macro setd1(d, r) {
	alu_r = (d & 0xff000000ffffff) | (zext(r) << 24);
}

#   pattern      mnemonic   operands            constraints           semantics
ALUm: "move" is k7_0=0x0 { }
ALU:  is k7_0=0x0 {  }
ALUm: "tfr" is k7_4=0x0 & k2_0=0x1 { }
ALU: nacc3,acc3 is k7_4=0x0 & k2_0=0x1 & nacc3 & acc3 { alu_r = nacc3; }
ALUm: "addr" is k7_4=0x0 & k2_0=0x2 { }
ALU: nacc3,acc3 is k7_4=0x0 & k2_0=0x2 & nacc3 & acc3 { local h:7 = acc3 s>> 1; add56(h, nacc3); }
ALUm: "tst" is k7_4=0x0 & k2_0=0x3 { }
ALU: acc3 is k7_4=0x0 & k2_0=0x3 & acc3 { alu_r = acc3; nzeu(alu_r); V = 0; }
ALUm: "cmp" is k7_4=0x0 & k2_0=0x5 { }
ALU: nacc3,acc3 is k7_4=0x0 & k2_0=0x5 & nacc3 & acc3 { sub56(acc3, nacc3); }
ALUm: "subr" is k7_4=0x0 & k2_0=0x6 { }
ALU: nacc3,acc3 is k7_4=0x0 & k2_0=0x6 & nacc3 & acc3 { local h:7 = acc3 s>> 1; sub56(h, nacc3); }
ALUm: "cmpm" is k7_4=0x0 & k2_0=0x7 { }
ALU: nacc3,acc3 is k7_4=0x0 & k2_0=0x7 & nacc3 & acc3 { local d:7 = acc3; if (d s>= 0) goto <p1>; d = -d; <p1> local s:7 = nacc3; if (s s>= 0) goto <p2>; s = -s; <p2> sub56(d, s); }
ALUm: "add" is k7_4=0x1 & k2_0=0x0 { }
ALU: nacc3,acc3 is k7_4=0x1 & k2_0=0x0 & nacc3 & acc3 { add56(acc3, nacc3); }
ALUm: "rnd" is k7_4=0x1 & k2_0=0x1 { }
ALU: acc3 is k7_4=0x1 & k2_0=0x1 & acc3 { alu_r = rnd56(acc3); nzeu(alu_r); }
ALUm: "addl" is k7_4=0x1 & k2_0=0x2 { }
ALU: nacc3,acc3 is k7_4=0x1 & k2_0=0x2 & nacc3 & acc3 { local h:7 = acc3 << 1; add56(h, nacc3); V = V || ((acc3 s< 0) != (h s< 0)); }
ALUm: "clr" is k7_4=0x1 & k2_0=0x3 { }
ALU: acc3 is k7_4=0x1 & k2_0=0x3 & acc3 { alu_r = 0; E = 0; U = 1; N = 0; Z = 1; V = 0; }
ALUm: "sub" is k7_4=0x1 & k2_0=0x4 { }
ALU: nacc3,acc3 is k7_4=0x1 & k2_0=0x4 & nacc3 & acc3 { sub56(acc3, nacc3); }
ALUm: "maxm" is k7_0=0x15 { }
ALU: "a,b" is k7_0=0x15 { local sa:7 = a; if (sa s>= 0) goto <p1>; sa = -sa; <p1> local sb:7 = b; if (sb s>= 0) goto <p2>; sb = -sb; <p2> alu_r = b; C = 1; if (sb - sa s> 0) goto <done>; alu_r = a; C = 0; <done> }
ALUm: "max" is k7_0=0x1d { }
ALU: "a,b" is k7_0=0x1d { alu_r = b; C = 1; if (b - a s> 0) goto <done>; alu_r = a; C = 0; <done> }
ALUm: "subl" is k7_4=0x1 & k2_0=0x6 { }
ALU: nacc3,acc3 is k7_4=0x1 & k2_0=0x6 & nacc3 & acc3 { local h:7 = acc3 << 1; sub56(h, nacc3); V = V || ((acc3 s< 0) != (h s< 0)); }
ALUm: "not" is k7_4=0x1 & k2_0=0x7 { }
ALU: acc3 is k7_4=0x1 & k2_0=0x7 & acc3 { local r:3 = ~acc3[24,24]; setd1(acc3, r); nz24(r); }
ALUm: "add" is k7_5=0x1 & k2_0=0x0 { }
ALU: S48,acc3 is k7_5=0x1 & k2_0=0x0 & S48 & acc3 { add56(acc3, S48); }
ALUm: "adc" is k7_5=0x1 & k2_0=0x1 { }
ALU: S48,acc3 is k7_5=0x1 & k2_0=0x1 & S48 & acc3 { local s:7 = S48 + zext(C); add56(acc3, s); }
ALUm: "sub" is k7_5=0x1 & k2_0=0x4 { }
ALU: S48,acc3 is k7_5=0x1 & k2_0=0x4 & S48 & acc3 { sub56(acc3, S48); }
ALUm: "sbc" is k7_5=0x1 & k2_0=0x5 { }
ALU: S48,acc3 is k7_5=0x1 & k2_0=0x5 & S48 & acc3 { local s:7 = S48 + zext(C); sub56(acc3, s); }
ALUm: "asr" is k7_4=0x2 & k2_0=0x2 { }
ALU: acc3 is k7_4=0x2 & k2_0=0x2 & acc3 { C = (acc3 & 1) != 0; alu_r = acc3 s>> 1; V = 0; nzeu(alu_r); }
ALUm: "lsr" is k7_4=0x2 & k2_0=0x3 { }
ALU: acc3 is k7_4=0x2 & k2_0=0x3 & acc3 { local r:3 = acc3[24,24]; C = (r & 1) != 0; r = r >> 1; setd1(acc3, r); nz24(r); }
ALUm: "abs" is k7_4=0x2 & k2_0=0x6 { }
ALU: acc3 is k7_4=0x2 & k2_0=0x6 & acc3 { alu_r = acc3; if (alu_r s>= 0) goto <p>; alu_r = -alu_r; <p> V = alu_r s< 0; L = L || V; nzeu(alu_r); }
ALUm: "ror" is k7_4=0x2 & k2_0=0x7 { }
ALU: acc3 is k7_4=0x2 & k2_0=0x7 & acc3 { local r:3 = acc3[24,24]; local c:1 = (r & 1) != 0; r = (r >> 1) | (zext(C) << 23); C = c; setd1(acc3, r); nz24(r); }
ALUm: "asl" is k7_4=0x3 & k2_0=0x2 { }
ALU: acc3 is k7_4=0x3 & k2_0=0x2 & acc3 { C = acc3 s< 0; alu_r = acc3 << 1; V = (acc3 s< 0) != (alu_r s< 0); L = L || V; nzeu(alu_r); }
ALUm: "lsl" is k7_4=0x3 & k2_0=0x3 { }
ALU: acc3 is k7_4=0x3 & k2_0=0x3 & acc3 { local r:3 = acc3[24,24]; C = (r & 0x800000) != 0; r = r << 1; setd1(acc3, r); nz24(r); }
ALUm: "neg" is k7_4=0x3 & k2_0=0x6 { }
ALU: acc3 is k7_4=0x3 & k2_0=0x6 & acc3 { alu_r = -acc3; V = sborrow(0:7, acc3); L = L || V; nzeu(alu_r); }
ALUm: "rol" is k7_4=0x3 & k2_0=0x7 { }
ALU: acc3 is k7_4=0x3 & k2_0=0x7 & acc3 { local r:3 = acc3[24,24]; local c:1 = (r & 0x800000) != 0; r = (r << 1) | zext(C); C = c; setd1(acc3, r); nz24(r); }
ALUm: "add" is k7_6=0x1 & k2_0=0x0 { }
ALU: S56j,acc3 is k7_6=0x1 & k2_0=0x0 & S56j & acc3 { add56(acc3, S56j); }
ALUm: "tfr" is k7_6=0x1 & k2_0=0x1 { }
ALU: jj4,acc3 is k7_6=0x1 & k2_0=0x1 & jj4 & S56j & acc3 { alu_r = S56j; }
ALUm: "or" is k7_6=0x1 & k2_0=0x2 { }
ALU: jj4,acc3 is k7_6=0x1 & k2_0=0x2 & jj4 & acc3 { local r:3 = acc3[24,24] | jj4; setd1(acc3, r); nz24(r); }
ALUm: "eor" is k7_6=0x1 & k2_0=0x3 { }
ALU: jj4,acc3 is k7_6=0x1 & k2_0=0x3 & jj4 & acc3 { local r:3 = acc3[24,24] ^ jj4; setd1(acc3, r); nz24(r); }
ALUm: "sub" is k7_6=0x1 & k2_0=0x4 { }
ALU: S56j,acc3 is k7_6=0x1 & k2_0=0x4 & S56j & acc3 { sub56(acc3, S56j); }
ALUm: "cmp" is k7_6=0x1 & k2_0=0x5 { }
ALU: S56j,acc3 is k7_6=0x1 & k2_0=0x5 & S56j & acc3 { sub56(acc3, S56j); }
ALUm: "and" is k7_6=0x1 & k2_0=0x6 { }
ALU: jj4,acc3 is k7_6=0x1 & k2_0=0x6 & jj4 & acc3 { local r:3 = acc3[24,24] & jj4; setd1(acc3, r); nz24(r); }
ALUm: "cmpm" is k7_6=0x1 & k2_0=0x7 { }
ALU: S56j,acc3 is k7_6=0x1 & k2_0=0x7 & S56j & acc3 { local d:7 = acc3; if (d s>= 0) goto <p1>; d = -d; <p1> local s:7 = S56j; if (s s>= 0) goto <p2>; s = -s; <p2> sub56(d, s); }
ALUm: "mpy" is k7_7=0x1 & k2_0=0x0 { }
ALU: MulQ,acc3 is k7_7=0x1 & k2_0=0x0 & MulQ & acc3 { alu_r = MulQ; V = 0; nzeu(alu_r); }
ALUm: "mpy" is k7_7=0x1 & k2_0=0x4 { }
ALU: "-"^MulQ,acc3 is k7_7=0x1 & k2_0=0x4 & MulQ & acc3 { alu_r = -MulQ; V = 0; nzeu(alu_r); }
ALUm: "mpyr" is k7_7=0x1 & k2_0=0x1 { }
ALU: MulQ,acc3 is k7_7=0x1 & k2_0=0x1 & MulQ & acc3 { alu_r = rnd56(MulQ); V = 0; nzeu(alu_r); }
ALUm: "mpyr" is k7_7=0x1 & k2_0=0x5 { }
ALU: "-"^MulQ,acc3 is k7_7=0x1 & k2_0=0x5 & MulQ & acc3 { local p:7 = -MulQ; alu_r = rnd56(p); V = 0; nzeu(alu_r); }
ALUm: "mac" is k7_7=0x1 & k2_0=0x2 { }
ALU: MulQ,acc3 is k7_7=0x1 & k2_0=0x2 & MulQ & acc3 { add56(acc3, MulQ); }
ALUm: "mac" is k7_7=0x1 & k2_0=0x6 { }
ALU: "-"^MulQ,acc3 is k7_7=0x1 & k2_0=0x6 & MulQ & acc3 { sub56(acc3, MulQ); }
ALUm: "macr" is k7_7=0x1 & k2_0=0x3 { }
ALU: MulQ,acc3 is k7_7=0x1 & k2_0=0x3 & MulQ & acc3 { add56(acc3, MulQ); alu_r = rnd56(alu_r); nzeu(alu_r); }
ALUm: "macr" is k7_7=0x1 & k2_0=0x7 { }
ALU: "-"^MulQ,acc3 is k7_7=0x1 & k2_0=0x7 & MulQ & acc3 { sub56(acc3, MulQ); alu_r = rnd56(alu_r); nzeu(alu_r); }

# Write-back of the ALU result (after the parallel move has read its sources)
ALUW: is acc3 { acc3 = alu_r; }
ALUW: is k7_0=0x0 { }
ALUW: is k7_4=0x0 & k2_0=0x3 { }
ALUW: is k7_4=0x0 & k2_0=0x5 { }
ALUW: is k7_4=0x0 & k2_0=0x7 { }
ALUW: is k7_6=0x1 & k2_0=0x5 { }
ALUW: is k7_6=0x1 & k2_0=0x7 { }
ALUW: is k7_4=0x1 & k2_0=0x5 { b = alu_r; }

# ============================================================ parallel moves
# Each PM constructor performs all of its reads before any of its writes.
PM: is k23_8=0x2000 { }

# #xx,D : 8-bit immediate; left aligned for x0..y1/a/b, right aligned otherwise
PM: "#<"^k15_8^","^R5w16 is k23_21=0x1 & k15_8 & R5w16 { mv1 = k15_8; build R5w16; }
PM: "#<"^k15_8^","^R5w16 is k23_18=0x9 & k15_8 & R5w16 { mv1 = k15_8 << 16; build R5w16; }
PM: "#<"^k15_8^","^R5w16 is k23_17=0x17 & k15_8 & R5w16 { mv1 = k15_8 << 16; build R5w16; }

# S,D register to register
PM: R5r13^","^R5w8 is k23_18=0x8 & R5r13 & R5w8 { mv1 = R5r13; build R5w8; }

# ea update only
PM: EA4 is k23_13=0x102 & EA4 & ea_r { ea_r = EA4; }

# X or Y memory, ea / absolute / immediate
PM: "x:"^EA^","^R5wS  is (k23_22=0x1 & k19_19=0x0 & k15_14=0x3 & R5wS) ... & EA  { mv1 = *[X]:3 EA; build R5wS; }
PM: R5rS^",x:"^EA     is (k23_22=0x1 & k19_19=0x0 & k15_14=0x1 & R5rS) ... & EA  { mv1 = R5rS; *[X]:3 EA = mv1; }
PM: "y:"^EA^","^R5wS  is (k23_22=0x1 & k19_19=0x1 & k15_14=0x3 & R5wS) ... & EA  { mv1 = *[Y]:3 EA; build R5wS; }
PM: R5rS^",y:"^EA     is (k23_22=0x1 & k19_19=0x1 & k15_14=0x1 & R5rS) ... & EA  { mv1 = R5rS; *[Y]:3 EA = mv1; }
PM: IMM^","^R5wS      is (k23_22=0x1 & k19_19=0x0 & k15_14=0x3 & R5wS) ... & IMM { mv1 = IMM; build R5wS; }
PM: IMM^","^R5wS      is (k23_22=0x1 & k19_19=0x1 & k15_14=0x3 & R5wS) ... & IMM { mv1 = IMM; build R5wS; }
# X or Y memory, short absolute
PM: "x:<"^k13_8^","^R5wS is k23_22=0x1 & k19_19=0x0 & k15_14=0x2 & k13_8 & R5wS { mv1 = *[X]:3 k13_8:3; build R5wS; }
PM: R5rS^",x:<"^k13_8    is k23_22=0x1 & k19_19=0x0 & k15_14=0x0 & k13_8 & R5rS { mv1 = R5rS; *[X]:3 k13_8:3 = mv1; }
PM: "y:<"^k13_8^","^R5wS is k23_22=0x1 & k19_19=0x1 & k15_14=0x2 & k13_8 & R5wS { mv1 = *[Y]:3 k13_8:3; build R5wS; }
PM: R5rS^",y:<"^k13_8    is k23_22=0x1 & k19_19=0x1 & k15_14=0x0 & k13_8 & R5rS { mv1 = R5rS; *[Y]:3 k13_8:3 = mv1; }

# L: long (X:Y pair) moves.  LLL = bit 19, bits 17..16.  Bit 19 is spelled out
# in each PM pattern so these outrank the X/Y forms (whose register code would
# be invalid here); SLEIGH does not consult subtable patterns when choosing.
LSr: "a10" is k19_19=0 & k17_16=0 { local v:6 = a10; export v; }
LSr: "b10" is k19_19=0 & k17_16=1 { local v:6 = b10; export v; }
LSr: "x"   is k19_19=0 & k17_16=2 { export x; }
LSr: "y"   is k19_19=0 & k17_16=3 { export y; }
LSr: "a"   is k19_19=1 & k17_16=0 { local v:6 = sat48(a); export v; }
LSr: "b"   is k19_19=1 & k17_16=1 { local v:6 = sat48(b); export v; }
LSr: "ab"  is k19_19=1 & k17_16=2 { local h:3 = sat24(a); local l:3 = sat24(b); local v:6 = (zext(h) << 24) | zext(l); export v; }
LSr: "ba"  is k19_19=1 & k17_16=3 { local h:3 = sat24(b); local l:3 = sat24(a); local v:6 = (zext(h) << 24) | zext(l); export v; }
LDw: "a10" is k19_19=0 & k17_16=0 { a10 = zext(mv1) << 24 | zext(mv2); }
LDw: "b10" is k19_19=0 & k17_16=1 { b10 = zext(mv1) << 24 | zext(mv2); }
LDw: "x"   is k19_19=0 & k17_16=2 { x1 = mv1; x0 = mv2; }
LDw: "y"   is k19_19=0 & k17_16=3 { y1 = mv1; y0 = mv2; }
LDw: "a"   is k19_19=1 & k17_16=0 { local v:7 = sext(mv1); a = (v << 24) | zext(mv2); }
LDw: "b"   is k19_19=1 & k17_16=1 { local v:7 = sext(mv1); b = (v << 24) | zext(mv2); }
LDw: "ab"  is k19_19=1 & k17_16=2 { fr56(a, mv1); fr56(b, mv2); }
LDw: "ba"  is k19_19=1 & k17_16=3 { fr56(b, mv1); fr56(a, mv2); }

PM: "l:"^EA^","^LDw      is (k23_18=0x10 & k15_14=0x3 & LDw) ... & EA { mv1 = *[X]:3 EA; mv2 = *[Y]:3 EA; build LDw; }
PM: "l:"^EA^","^LDw      is (k23_18=0x12 & k15_14=0x3 & LDw) ... & EA { mv1 = *[X]:3 EA; mv2 = *[Y]:3 EA; build LDw; }
PM: LSr^",l:"^EA         is (k23_18=0x10 & k15_14=0x1 & LSr) ... & EA { local v:6 = LSr; *[X]:3 EA = v(3); *[Y]:3 EA = v:3; }
PM: LSr^",l:"^EA         is (k23_18=0x12 & k15_14=0x1 & LSr) ... & EA { local v:6 = LSr; *[X]:3 EA = v(3); *[Y]:3 EA = v:3; }
PM: "l:<"^k13_8^","^LDw  is k23_18=0x10 & k15_14=0x2 & k13_8 & LDw { mv1 = *[X]:3 k13_8:3; mv2 = *[Y]:3 k13_8:3; build LDw; }
PM: "l:<"^k13_8^","^LDw  is k23_18=0x12 & k15_14=0x2 & k13_8 & LDw { mv1 = *[X]:3 k13_8:3; mv2 = *[Y]:3 k13_8:3; build LDw; }
PM: LSr^",l:<"^k13_8     is k23_18=0x10 & k15_14=0x0 & k13_8 & LSr { local v:6 = LSr; *[X]:3 k13_8:3 = v(3); *[Y]:3 k13_8:3 = v:3; }
PM: LSr^",l:<"^k13_8     is k23_18=0x12 & k15_14=0x0 & k13_8 & LSr { local v:6 = LSr; *[X]:3 k13_8:3 = v(3); *[Y]:3 k13_8:3 = v:3; }

# Single register views used by the X:R, R:Y and X:Y forms
XR2r: "x0" is k19_18=0 { export x0; }
XR2r: "x1" is k19_18=1 { export x1; }
XR2r: "a"  is k19_18=2 { local v:3 = sat24(a); export v; }
XR2r: "b"  is k19_18=3 { local v:3 = sat24(b); export v; }
XR2w: "x0" is k19_18=0 { x0 = mv1; }
XR2w: "x1" is k19_18=1 { x1 = mv1; }
XR2w: "a"  is k19_18=2 { fr56(a, mv1); }
XR2w: "b"  is k19_18=3 { fr56(b, mv1); }
YR2r: "y0" is k17_16=0 { export y0; }
YR2r: "y1" is k17_16=1 { export y1; }
YR2r: "a"  is k17_16=2 { local v:3 = sat24(a); export v; }
YR2r: "b"  is k17_16=3 { local v:3 = sat24(b); export v; }
YR2w: "y0" is k17_16=0 { y0 = mv2; }
YR2w: "y1" is k17_16=1 { y1 = mv2; }
YR2w: "a"  is k17_16=2 { fr56(a, mv2); }
YR2w: "b"  is k17_16=3 { fr56(b, mv2); }
Y1w16: "y0" is k16_16=0 { y0 = mv2; }
Y1w16: "y1" is k16_16=1 { y1 = mv2; }
X1w18: "x0" is k18_18=0 { x0 = mv1; }
X1w18: "x1" is k18_18=1 { x1 = mv1; }

# X:R  -- X memory move plus accumulator (bit 17) to y0/y1 (bit 16)
PM: "x:"^EA^","^XR2w^" "^acc17^","^Y1w16 is (k23_20=0x1 & k15_14=0x2 & XR2w & acc17 & Y1w16) ... & EA
	{ mv1 = *[X]:3 EA; mv2 = sat24(acc17); build XR2w; build Y1w16; }
PM: XR2r^",x:"^EA^" "^acc17^","^Y1w16    is (k23_20=0x1 & k15_14=0x0 & XR2r & acc17 & Y1w16) ... & EA
	{ mv1 = XR2r; mv2 = sat24(acc17); *[X]:3 EA = mv1; build Y1w16; }
PM: IMM^","^XR2w^" "^acc17^","^Y1w16     is (k23_20=0x1 & k15_14=0x2 & XR2w & acc17 & Y1w16) ... & IMM
	{ mv1 = IMM; mv2 = sat24(acc17); build XR2w; build Y1w16; }
# R:Y  -- accumulator (bit 19) to x0/x1 (bit 18) plus Y memory move
PM: acc19^","^X1w18^" y:"^EA^","^YR2w is (k23_20=0x1 & k15_14=0x3 & acc19 & X1w18 & YR2w) ... & EA
	{ mv1 = sat24(acc19); mv2 = *[Y]:3 EA; build X1w18; build YR2w; }
PM: acc19^","^X1w18^" "^YR2r^",y:"^EA is (k23_20=0x1 & k15_14=0x1 & acc19 & X1w18 & YR2r) ... & EA
	{ mv1 = sat24(acc19); mv2 = YR2r; *[Y]:3 EA = mv2; build X1w18; }
PM: acc19^","^X1w18^" "^IMM^","^YR2w  is (k23_20=0x1 & k15_14=0x3 & acc19 & X1w18 & YR2w) ... & IMM
	{ mv1 = sat24(acc19); mv2 = IMM; build X1w18; build YR2w; }

# Class II:  A -> X:ea, X0 -> A   /   Y0 -> A, A -> Y:ea
PM: acc16^",x:"^EA^" x0,"^acc16b is (k23_17=0x4 & k15_14=0x0 & acc16 & acc16b) ... & EA
	{ mv1 = sat24(acc16); *[X]:3 EA = mv1; fr56(acc16, x0); }
PM: "y0,"^acc16^" "^acc16b^",y:"^EA is (k23_17=0x4 & k15_14=0x2 & acc16 & acc16b) ... & EA
	{ mv1 = sat24(acc16); *[Y]:3 EA = mv1; fr56(acc16, y0); }

# X:Y dual moves.  W (bit 15) = X direction, w (bit 22) = Y direction
PM: "x:"^XEA^","^XR2w^" y:"^YEA^","^YR2w is k23_22=0x3 & k15_15=0x1 & XEA & XR2w & YEA & YR2w
	{ mv1 = *[X]:3 XEA; mv2 = *[Y]:3 YEA; build XR2w; build YR2w; }
PM: XR2r^",x:"^XEA^" y:"^YEA^","^YR2w    is k23_22=0x3 & k15_15=0x0 & XEA & XR2r & YEA & YR2w
	{ mv1 = XR2r; mv2 = *[Y]:3 YEA; *[X]:3 XEA = mv1; build YR2w; }
PM: "x:"^XEA^","^XR2w^" "^YR2r^",y:"^YEA is k23_22=0x2 & k15_15=0x1 & XEA & XR2w & YEA & YR2r
	{ mv1 = *[X]:3 XEA; mv2 = YR2r; *[Y]:3 YEA = mv2; build XR2w; }
PM: XR2r^",x:"^XEA^" "^YR2r^",y:"^YEA    is k23_22=0x2 & k15_15=0x0 & XEA & XR2r & YEA & YR2r
	{ mv1 = XR2r; mv2 = YR2r; *[X]:3 XEA = mv1; *[Y]:3 YEA = mv2; }

# ======================================================= parallel instructions
instr: ALUm ALU PM is (ALU & ALUm & ALUW) ... & PM {
	build ALU;
	build PM;
	build ALUW;
}

instr: ALUm ALU "if"^CC8 is k23_12=0x202 & ALU & ALUm & ALUW & CC8 {
	local cond:1 = CC8;
	local fc = C; local fv = V; local fz = Z; local fn = N;
	local fu = U; local fe = E; local fl = L;
	build ALU;
	C = fc; V = fv; Z = fz; N = fn; U = fu; E = fe; L = fl;
	if (!cond) goto <skip>;
	build ALUW;
<skip>
}

instr: ALUm ALU "if"^CC8^".u" is k23_12=0x203 & ALU & ALUm & ALUW & CC8 {
	local cond:1 = CC8;
	local fc = C; local fv = V; local fz = Z; local fn = N;
	local fu = U; local fe = E; local fl = L;
	build ALU;
	if (cond) goto <take>;
	C = fc; V = fv; Z = fz; N = fn; U = fu; E = fe; L = fl;
	goto <skip>;
<take>
	build ALUW;
<skip>
}

# ===================================================== non-parallel helpers
attach variables [ q4a ] [ x0 y0 x1 y1 x0 y0 x1 y1 x1 y1 x0 y0 y1 x0 y0 x1 ];
attach variables [ q4b ] [ x0 y0 x0 y0 y1 x0 y0 x1 x1 y1 x1 y1 x0 y0 x1 y1 ];
attach variables [ qq2 ] [ y1 x0 y0 x1 ];
attach variables [ jq4 ] [ x0 y0 x1 y1 ];

# peripheral operands with the pp/qq field in bits 5..0
Mpp16: "x:<<"^pa is k16_16=0 & k5_0 [ pa = 0xffffc0 + k5_0; ] { export *[X]:3 pa; }
Mpp16: "y:<<"^pa is k16_16=1 & k5_0 [ pa = 0xffffc0 + k5_0; ] { export *[Y]:3 pa; }
Mqqx0: "x:<<"^pa is k5_0 [ pa = 0xffff80 + k5_0; ] { export *[X]:3 pa; }
Mqqy0: "y:<<"^pa is k5_0 [ pa = 0xffff80 + k5_0; ] { export *[Y]:3 pa; }
Mqq6s: "x:<<"^pa is k6_6=0 & k5_0 [ pa = 0xffff80 + k5_0; ] { export *[X]:3 pa; }
Mqq6s: "y:<<"^pa is k6_6=1 & k5_0 [ pa = 0xffff80 + k5_0; ] { export *[Y]:3 pa; }
MqqXs: "x:<<"^pa is k6_6 & k4_0 [ pa = 0xffff80 + (k6_6 << 5) + k4_0; ] { export *[X]:3 pa; }
MqqYs: "y:<<"^pa is k6_6 & k4_0 [ pa = 0xffff80 + (k6_6 << 5) + k4_0; ] { export *[Y]:3 pa; }
PEA:   "p:"^EA is EA { export *[P]:3 EA; }
Paa:   "p:<"^k13_8 is k13_8 { export *[P]:3 k13_8; }

# loop end operands: export the last word of the loop (LA), display LA+1
LAabs: lp1 is ext24 [ lp1 = ext24 + 1; ] { export *[P]:3 ext24; }
LAend: lp1 is ext24 [ lp1 = ext24 + 1; ] { export *[P]:3 lp1; }
LArel: lad is sext24 [ lad = inst_start + sext24; ] { export *[P]:3 lad; }
LArend: lp1 is sext24 [ lp1 = inst_start + sext24 + 1; ] { export *[P]:3 lp1; }
LAval: is ext24 { export *[const]:3 ext24; }
LArval: lad is sext24 [ lad = inst_start + sext24; ] { export *[const]:3 lad; }

# 12-bit loop / repeat count: hhhh (3..0) : iiiiiiii (15..8)
Cnt12: "#"^cnt is k3_0 & k15_8 [ cnt = (k3_0 << 8) | k15_8; ] { export *[const]:3 cnt; }

# 6-bit and 5-bit bit numbers
BitN: "#"^k4_0 is k4_4=0 & k4_0 { local bitv:3 = 1 << k4_0; export bitv; }
BitN: "#"^k4_0 is k4_3=2 & k4_0 { local bitv:3 = 1 << k4_0; export bitv; }

# accumulator source for the ALU forms that name a second 24-bit operand
ACT3: "a1" is k3_1=2 { export a1; }
ACT3: "b1" is k3_1=3 { export b1; }
ACT3: "x0" is k3_1=4 { export x0; }
ACT3: "y0" is k3_1=5 { export y0; }
ACT3: "x1" is k3_1=6 { export x1; }
ACT3: "y1" is k3_1=7 { export y1; }

# Tcc first source
TccS: nacc3 is k6_4=0 & nacc3 { export nacc3; }
TccS: S56j  is k6_6=1 & S56j  { export S56j; }

macro push(hi, lo) {
	ssp = ssp + 6;
	*[SS]:3 (ssp + 3) = hi;
	*[SS]:3 ssp = lo;
}

macro jsrTo(dest) {
	local ret:3 = inst_next;
	push(ret, sr);
	call dest;
}

macro doLoop(cnt, lastword, top) {
	push(la, lc);
	push(top, sr);
	la = lastword;
	lc = cnt;
}

macro popLoop() {
	lc = *[SS]:3 (ssp - 6);
	la = *[SS]:3 (ssp - 3);
	ssp = ssp - 12;
}

# ============================================================ instructions
instr: "nop" is k23_0=0x0 { }
instr: "rts" is k23_0=0xc {
	local ra:3 = *[SS]:3 (ssp + 3);
	ssp = ssp - 6;
	return [ra];
}
instr: "rti" is k23_0=0x4 {
	local ra:3 = *[SS]:3 (ssp + 3);
	local s:3 = *[SS]:3 ssp;
	ssp = ssp - 6;
	unpackSR(s);
	return [ra];
}
instr: "illegal" is k23_0=0x5 { illegal_instruction(); }
instr: "trap"    is k23_0=0x6 { software_interrupt(); }
instr: "trap"^CC0 is k23_4=0x1 & CC0 { if (!CC0) goto inst_next; software_interrupt(); }
instr: "debug"   is k23_0=0x200 { debug_request(); }
instr: "debug"^CC0 is k23_4=0x30 & CC0 { if (!CC0) goto inst_next; debug_request(); }
instr: "pflush"   is k23_0=0x3 { cache_control(); }
instr: "pflushun" is k23_0=0x1 { cache_control(); }
instr: "pfree"    is k23_0=0x2 { cache_control(); }
instr: "reset"    is k23_7=0x1 & k5_5=0x0 & k3_0=0x4 { reset_peripherals(); }
instr: "stop"     is k23_7=0x1 & k5_5=0x0 & k3_0=0x7 { halt_stop(); }
instr: "wait"     is k23_7=0x1 & k5_5=0x0 & k3_0=0x6 { halt_wait(); }
instr: "plockr" Rel24   is k23_0=0xf ; Rel24 { cache_control(); }
instr: "punlockr" Rel24 is k23_0=0xe ; Rel24 { cache_control(); }
instr: "plock" EA   is (k23_14=0x2f & k7_0=0x81) ... & EA { cache_control(); }
instr: "punlock" EA is (k23_14=0x2b & k7_0=0x81) ... & EA { cache_control(); }

instr: "dec" acc0 is k23_1=0x5 & acc0 { local o:7 = acc0; sub56(o, 1:7); acc0 = alu_r; }
instr: "inc" acc0 is k23_1=0x4 & acc0 { local o:7 = acc0; add56(o, 1:7); acc0 = alu_r; }

# AND(I) / OR(I) on mr, ccr, com, eom
instr: "andi" "#"^k15_8^",mr"  is k23_16=0x0 & k7_0=0xb8 & k15_8 { sr = sr & ((k15_8 << 8) | 0xff00ff); }
instr: "andi" "#"^k15_8^",ccr" is k23_16=0x0 & k7_0=0xb9 & k15_8 { local v:3 = 0; packSR(v); v = v & (0xffff00 | k15_8); unpackCCR(v); }
instr: "andi" "#"^k15_8^",com" is k23_16=0x0 & k7_0=0xba & k15_8 { omr = omr & (0xffff00 | k15_8); }
instr: "andi" "#"^k15_8^",eom" is k23_16=0x0 & k7_0=0xbb & k15_8 { omr = omr & ((k15_8 << 8) | 0xff00ff); }
instr: "ori" "#"^k15_8^",mr"   is k23_16=0x0 & k7_0=0xf8 & k15_8 { sr = sr | (k15_8 << 8); }
instr: "ori" "#"^k15_8^",ccr"  is k23_16=0x0 & k7_0=0xf9 & k15_8 { local v:3 = 0; packSR(v); v = v | k15_8; unpackCCR(v); }
instr: "ori" "#"^k15_8^",com"  is k23_16=0x0 & k7_0=0xfa & k15_8 { omr = omr | k15_8; }
instr: "ori" "#"^k15_8^",eom"  is k23_16=0x0 & k7_0=0xfb & k15_8 { omr = omr | (k15_8 << 8); }

# ------------------------------------------------------------ immediate ALU
instr: "add" "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x0 & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; add56(acc3, s); acc3 = alu_r; }
instr: "sub" "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x4 & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; sub56(acc3, s); acc3 = alu_r; }
instr: "cmp" "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x5 & k13_8 & acc3 { local s:7 = zext(k13_8:3) << 24; sub56(acc3, s); }
instr: "and" "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x6 & k13_8 & acc3 { local r:3 = acc3[24,24] & k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "or"  "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x2 & k13_8 & acc3 { local r:3 = acc3[24,24] | k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "eor" "#"^k13_8^","^acc3 is k23_14=0x5 & k7_6=0x2 & k2_0=0x3 & k13_8 & acc3 { local r:3 = acc3[24,24] ^ k13_8; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "add" "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x0 & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; add56(acc3, s); acc3 = alu_r; }
instr: "sub" "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x4 & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; sub56(acc3, s); acc3 = alu_r; }
instr: "cmp" "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x5 & acc3 ; ext24 { local s:7 = sext(ext24:3); s = s << 24; sub56(acc3, s); }
instr: "and" "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x6 & acc3 ; ext24 { local r:3 = acc3[24,24] & ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "or"  "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x2 & acc3 ; ext24 { local r:3 = acc3[24,24] | ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }
instr: "eor" "#>"^ext24^","^acc3 is k23_14=0x5 & k7_6=0x3 & k2_0=0x3 & acc3 ; ext24 { local r:3 = acc3[24,24] ^ ext24; setd1(acc3, r); acc3 = alu_r; nz24(r); }

# ----------------------------------------------------------- multiplies
# (+/-)S,#n,D : S * 2^-n
instr: "mpy"  qq2^",#"^k12_8^","^acc3      is k23_13=0x8 & k7_6=0x3 & k2_0=0x0 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpy"  "-"^qq2^",#"^k12_8^","^acc3  is k23_13=0x8 & k7_6=0x3 & k2_0=0x4 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = -p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyr" qq2^",#"^k12_8^","^acc3      is k23_13=0x8 & k7_6=0x3 & k2_0=0x1 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyr" "-"^qq2^",#"^k12_8^","^acc3  is k23_13=0x8 & k7_6=0x3 & k2_0=0x5 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = -((p << 24) s>> k12_8); alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mac"  qq2^",#"^k12_8^","^acc3      is k23_13=0x8 & k7_6=0x3 & k2_0=0x2 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; add56(acc3, p); acc3 = alu_r; }
instr: "mac"  "-"^qq2^",#"^k12_8^","^acc3  is k23_13=0x8 & k7_6=0x3 & k2_0=0x6 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; sub56(acc3, p); acc3 = alu_r; }
instr: "macr" qq2^",#"^k12_8^","^acc3      is k23_13=0x8 & k7_6=0x3 & k2_0=0x3 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; add56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }
instr: "macr" "-"^qq2^",#"^k12_8^","^acc3  is k23_13=0x8 & k7_6=0x3 & k2_0=0x7 & qq2 & k12_8 & acc3 { local p:7 = sext(qq2); p = (p << 24) s>> k12_8; sub56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }

# (+/-)#xxxx,S,D
MImm: "#>"^ext24 is ext24 { local p:7 = sext(ext24:3); export p; }
instr: "mpyi"  MImm^","^jq4^","^acc3     is k23_14=0x5 & k8_6=0x7 & k2_0=0x0 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyi"  "-"^MImm^","^jq4^","^acc3 is k23_14=0x5 & k8_6=0x7 & k2_0=0x4 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = -p; V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyri" MImm^","^jq4^","^acc3     is k23_14=0x5 & k8_6=0x7 & k2_0=0x1 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "mpyri" "-"^MImm^","^jq4^","^acc3 is k23_14=0x5 & k8_6=0x7 & k2_0=0x5 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; p = -p; alu_r = rnd56(p); V = 0; nzeu(alu_r); acc3 = alu_r; }
instr: "maci"  MImm^","^jq4^","^acc3     is k23_14=0x5 & k8_6=0x7 & k2_0=0x2 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; add56(acc3, p); acc3 = alu_r; }
instr: "maci"  "-"^MImm^","^jq4^","^acc3 is k23_14=0x5 & k8_6=0x7 & k2_0=0x6 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; sub56(acc3, p); acc3 = alu_r; }
instr: "macri" MImm^","^jq4^","^acc3     is k23_14=0x5 & k8_6=0x7 & k2_0=0x3 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; add56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }
instr: "macri" "-"^MImm^","^jq4^","^acc3 is k23_14=0x5 & k8_6=0x7 & k2_0=0x7 & jq4 & acc3 ; MImm { local p:7 = (MImm * sext(jq4)) << 1; sub56(acc3, p); acc3 = rnd56(alu_r); nzeu(acc3); }

# signed x unsigned / unsigned x unsigned; QQQQ operand pairs in bits 3..0
QSU: q4a^","^q4b is q4a & q4b { local p:7 = (sext(q4a) * zext(q4b)) << 1; export p; }
QUU: q4a^","^q4b is q4a & q4b { local p:7 = (zext(q4a) * zext(q4b)) << 1; export p; }
QSS: q4a^","^q4b is q4a & q4b { local p:7 = (sext(q4a) * sext(q4b)) << 1; export p; }
instr: "macsu" QSU^","^acc5     is k23_6=0x49a & k4_4=0x0 & QSU & acc5 { add56(acc5, QSU); acc5 = alu_r; }
instr: "macsu" "-"^QSU^","^acc5 is k23_6=0x49a & k4_4=0x1 & QSU & acc5 { sub56(acc5, QSU); acc5 = alu_r; }
instr: "macuu" QUU^","^acc5     is k23_6=0x49b & k4_4=0x0 & QUU & acc5 { add56(acc5, QUU); acc5 = alu_r; }
instr: "macuu" "-"^QUU^","^acc5 is k23_6=0x49b & k4_4=0x1 & QUU & acc5 { sub56(acc5, QUU); acc5 = alu_r; }
instr: "mpysu" QSU^","^acc5     is k23_6=0x49e & k4_4=0x0 & QSU & acc5 { alu_r = QSU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpysu" "-"^QSU^","^acc5 is k23_6=0x49e & k4_4=0x1 & QSU & acc5 { alu_r = -QSU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpyuu" QUU^","^acc5     is k23_6=0x49f & k4_4=0x0 & QUU & acc5 { alu_r = QUU; V = 0; nzeu(alu_r); acc5 = alu_r; }
instr: "mpyuu" "-"^QUU^","^acc5 is k23_6=0x49f & k4_4=0x1 & QUU & acc5 { alu_r = -QUU; V = 0; nzeu(alu_r); acc5 = alu_r; }
# DMAC: acc = (acc >> 24) +/- s1*s2
instr: "dmacss" QSS^","^acc5     is k23_6=0x492 & k4_4=0x0 & QSS & acc5 { local d:7 = acc5 s>> 24; add56(d, QSS); acc5 = alu_r; }
instr: "dmacss" "-"^QSS^","^acc5 is k23_6=0x492 & k4_4=0x1 & QSS & acc5 { local d:7 = acc5 s>> 24; sub56(d, QSS); acc5 = alu_r; }
instr: "dmacsu" QSU^","^acc5     is k23_6=0x496 & k4_4=0x0 & QSU & acc5 { local d:7 = acc5 s>> 24; add56(d, QSU); acc5 = alu_r; }
instr: "dmacsu" "-"^QSU^","^acc5 is k23_6=0x496 & k4_4=0x1 & QSU & acc5 { local d:7 = acc5 s>> 24; sub56(d, QSU); acc5 = alu_r; }
instr: "dmacuu" QUU^","^acc5     is k23_6=0x497 & k4_4=0x0 & QUU & acc5 { local d:7 = acc5 s>> 24; add56(d, QUU); acc5 = alu_r; }
instr: "dmacuu" "-"^QUU^","^acc5 is k23_6=0x497 & k4_4=0x1 & QUU & acc5 { local d:7 = acc5 s>> 24; sub56(d, QUU); acc5 = alu_r; }

# ---------------------------------------------------- other data ALU ops
instr: "div" jj4^","^acc3 is k23_6=0x601 & k2_0=0x0 & jj4 & acc3 { acc3 = div_step(acc3, jj4, C); C = acc3 s>= 0; V = 0; }
instr: "norm" ea_r^","^acc3 is k23_11=0x3b & k7_4=0x1 & k2_0=0x5 & ea_r & acc3 { acc3 = norm_step(acc3, ea_r); ea_r = norm_step(acc3, ea_r); }
instr: "normf" ACT3^","^acc0 is k23_4=0xc1e2 & ACT3 & acc0 { acc0 = normf(acc0, ACT3); nzeu(acc0); }
instr: "clb" acc1^","^acc0 is k23_2=0x30780 & acc1 & acc0 { local n:3 = clb(acc1); fr56(acc0, n); nzeu(acc0); }
instr: "cmpu" nacc0^","^acc0 is k23_1=0x60ff8 & nacc0 & acc0 { C = acc0 < nacc0; Z = acc0 == nacc0; N = 0; V = 0; }
instr: "cmpu" ACT3^","^acc0  is k23_4=0xc1ff & k3_3=1 & ACT3 & acc0 { local s:7 = zext(ACT3) << 24; local d:7 = acc0 & 0xffffffffffff; C = d < s; Z = d == s; N = 0; V = 0; }

instr: "asl" "#"^k6_1^","^acc7^","^acc0 is k23_8=0xc1d & k6_1 & acc7 & acc0 {
	local n:7 = k6_1; local r:7 = acc7 << n; C = n != 0 && ((acc7 >> (56 - n)) & 1) != 0;
	V = (r s>> n) != acc7; L = L || V; acc0 = r; nzeu(r);
}
instr: "asr" "#"^k6_1^","^acc7^","^acc0 is k23_8=0xc1c & k6_1 & acc7 & acc0 {
	local n:7 = k6_1; C = n != 0 && ((acc7 >> (n - 1)) & 1) != 0;
	local r:7 = acc7 s>> n; V = 0; acc0 = r; nzeu(r);
}
instr: "asl" ACT3^","^acc4^","^acc0 is k23_5=0x60f2 & ACT3 & acc4 & acc0 {
	local n:7 = zext(ACT3 & 0x3f); local r:7 = acc4 << n; V = (r s>> n) != acc4; L = L || V; acc0 = r; nzeu(r);
}
instr: "asr" ACT3^","^acc4^","^acc0 is k23_5=0x60f3 & ACT3 & acc4 & acc0 {
	local n:7 = zext(ACT3 & 0x3f); local r:7 = acc4 s>> n; V = 0; acc0 = r; nzeu(r);
}
instr: "lsl" "#"^k5_1^","^acc0 is k23_6=0x307a & k5_1 & acc0 { local r:3 = acc0[24,24] << k5_1; setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsr" "#"^k5_1^","^acc0 is k23_6=0x307b & k5_1 & acc0 { local r:3 = acc0[24,24] >> k5_1; setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsl" ACT3^","^acc0 is k23_4=0xc1e1 & ACT3 & acc0 { local r:3 = acc0[24,24] << (ACT3 & 0x1f); setd1(acc0, r); acc0 = alu_r; nz24(r); }
instr: "lsr" ACT3^","^acc0 is k23_4=0xc1e3 & ACT3 & acc0 { local r:3 = acc0[24,24] >> (ACT3 & 0x1f); setd1(acc0, r); acc0 = alu_r; nz24(r); }

# bit-field operations; control word: width in bits 17..12, offset in bits 5..0
macro bfextract(src, ctl, dst, signed) {
	local w:7 = zext((ctl >> 12) & 0x3f);
	local o:7 = zext(ctl & 0x3f);
	local f:7 = (src >> o) & ((1 << w) - 1);
	local s:7 = (f << (56 - w)) s>> (56 - w);
	dst = f;
	if (signed == 0) goto <done>;
	dst = s;
<done>
	nzeu(dst);
}
instr: "extract" ACT3^","^acc4^","^acc0  is k23_5=0x60d0 & ACT3 & acc4 & acc0 { bfextract(acc4, ACT3, acc0, 1:1); }
instr: "extractu" ACT3^","^acc4^","^acc0 is k23_5=0x60d4 & ACT3 & acc4 & acc0 { bfextract(acc4, ACT3, acc0, 0:1); }
instr: "extract" "#>"^ext24^","^acc4^","^acc0  is k23_5=0x60c0 & k3_1=0x0 & acc4 & acc0 ; ext24 { local c:3 = ext24; bfextract(acc4, c, acc0, 1:1); }
instr: "extractu" "#>"^ext24^","^acc4^","^acc0 is k23_5=0x60c4 & k3_1=0x0 & acc4 & acc0 ; ext24 { local c:3 = ext24; bfextract(acc4, c, acc0, 0:1); }
INS3: "a0" is k6_4=2 { export a0; }
INS3: "b0" is k6_4=3 { export b0; }
INS3: "x0" is k6_4=4 { export x0; }
INS3: "y0" is k6_4=5 { export y0; }
INS3: "x1" is k6_4=6 { export x1; }
INS3: "y1" is k6_4=7 { export y1; }
macro bfinsert(src, ctl, dst) {
	local w:7 = zext((ctl >> 12) & 0x3f);
	local o:7 = zext(ctl & 0x3f);
	local m:7 = ((1 << w) - 1) << o;
	dst = (dst & ~m) | ((zext(src) << o) & m);
	nzeu(dst);
}
instr: "insert" ACT3^","^INS3^","^acc0 is k23_7=0x1836 & ACT3 & INS3 & acc0 { bfinsert(INS3, ACT3, acc0); }
instr: "insert" "#>"^ext24^","^INS3^","^acc0 is k23_7=0x1832 & k3_1=0x0 & INS3 & acc0 ; ext24 { local c:3 = ext24; bfinsert(INS3, c, acc0); }
instr: "merge" ACT3^","^acc0 is k23_4=0xc1b8 & ACT3 & acc0 { local r:3 = (ACT3 << 12) | (acc0[24,24] & 0xfff); setd1(acc0, r); acc0 = alu_r; nz24(r); }

# conditional transfers
instr: "t"^CC12 TccS^","^acc3 is k23_16=0x2 & k11_11=0x0 & k7_7=0x0 & CC12 & TccS & acc3 { if (!CC12) goto inst_next; acc3 = TccS; }
instr: "t"^CC12 TccS^","^acc3^" "^ea_r^","^t_r0 is k23_16=0x3 & k11_11=0x0 & k7_7=0x0 & CC12 & TccS & acc3 & ea_r & t_r0 { if (!CC12) goto inst_next; local s:3 = ea_r; acc3 = TccS; t_r0 = s; }
instr: "t"^CC12 ea_r^","^t_r0 is k23_16=0x2 & k11_11=0x1 & k7_7=0x0 & CC12 & ea_r & t_r0 { if (!CC12) goto inst_next; t_r0 = ea_r; }

# ------------------------------------------------------- AGU arithmetic
instr: "lua" EA4^","^R5w0 is k23_13=0x22 & k7_5=0x0 & EA4 & R5w0 { mv1 = EA4; build R5w0; }
LDisp: "+"^disp is s13_13=0 & s13_11 & k7_4 [ disp = (s13_11 << 4) | k7_4; ] { export *[const]:3 disp; }
LDisp: "-"^ndisp is s13_13=1 & s13_11 & k7_4 [ ndisp = -((s13_11 << 4) | k7_4); ] { local d:3 = -ndisp; export d; }
instr: "lua" "("^ea_r^LDisp^"),"^lua_d is k23_14=0x10 & ea_r & LDisp & lua_d { lua_d = ea_r + LDisp; }
instr: "lra" ea_r^","^R5w0 is k23_11=0x98 & k7_5=0x0 & ea_r & R5w0 { mv1 = inst_start + ea_r; build R5w0; }
instr: "lra" Rel24^","^R5w0 is k23_14=0x11 & k7_5=0x2 & R5w0 ; Rel24 & sext24 { mv1 = inst_start + sext24; build R5w0; }

# ----------------------------------------------------------- moves (np)
# X:(Rn+xxxx) / Y:(Rn+xxxx), long displacement
LDisp24: "+"^sext24 is sext24 & k23_23e=0 { export *[const]:3 sext24; }
LDisp24: "-"^nd is sext24 & k23_23e=1 [ nd = -sext24; ] { export *[const]:3 sext24; }
instr: "move" "x:("^ea_r^LDisp24^"),"^R6w0 is k23_11=0x14e & k7_6=0x3 & ea_r & R6w0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; mv1 = *[X]:3 ad; build R6w0; }
instr: "move" R6r0^",x:("^ea_r^LDisp24^")" is k23_11=0x14e & k7_6=0x2 & ea_r & R6r0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; *[X]:3 ad = R6r0; }
instr: "move" "y:("^ea_r^LDisp24^"),"^R6w0 is k23_11=0x16e & k7_6=0x3 & ea_r & R6w0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; mv1 = *[Y]:3 ad; build R6w0; }
instr: "move" R6r0^",y:("^ea_r^LDisp24^")" is k23_11=0x16e & k7_6=0x2 & ea_r & R6r0 ; LDisp24 & sext24 { local ad:3 = ea_r + sext24; *[Y]:3 ad = R6r0; }
# X:(Rn+xxx) / Y:(Rn+xxx), 7-bit displacement split over bits 16..11 and 6
Disp7: "+"^disp is s16_16=0 & s16_11 & k6_6 [ disp = (s16_11 << 1) | k6_6; ] { export *[const]:3 disp; }
Disp7: "-"^ndisp is s16_16=1 & s16_11 & k6_6 [ ndisp = -((s16_11 << 1) | k6_6); ] { local d:3 = -ndisp; export d; }
instr: "move" "x:("^ea_r^Disp7^"),"^D4w0 is k23_17=0x1 & k7_7=0x1 & k5_4=0x1 & ea_r & Disp7 & D4w0 { local ad:3 = ea_r + Disp7; mv1 = *[X]:3 ad; build D4w0; }
instr: "move" D4r0^",x:("^ea_r^Disp7^")" is k23_17=0x1 & k7_7=0x1 & k5_4=0x0 & ea_r & Disp7 & D4r0 { local ad:3 = ea_r + Disp7; *[X]:3 ad = D4r0; }
instr: "move" "y:("^ea_r^Disp7^"),"^D4w0 is k23_17=0x1 & k7_7=0x1 & k5_4=0x3 & ea_r & Disp7 & D4w0 { local ad:3 = ea_r + Disp7; mv1 = *[Y]:3 ad; build D4w0; }
instr: "move" D4r0^",y:("^ea_r^Disp7^")" is k23_17=0x1 & k7_7=0x1 & k5_4=0x2 & ea_r & Disp7 & D4r0 { local ad:3 = ea_r + Disp7; *[Y]:3 ad = D4r0; }

# MOVE(C)
instr: "movec" MEA6^","^C5w0 is (k23_14=0x17 & k7_7=0x0 & k5_5=0x1 & C5w0) ... & MEA6 { mv1 = MEA6; build C5w0; }
instr: "movec" C5r0^","^MEA6 is (k23_14=0x15 & k7_7=0x0 & k5_5=0x1 & C5r0) ... & MEA6 { MEA6 = C5r0; }
instr: "movec" IMM^","^C5w0  is (k23_14=0x17 & k7_7=0x0 & k5_5=0x1 & C5w0) ... & IMM { mv1 = IMM; build C5w0; }
instr: "movec" Maa6^","^C5w0 is k23_14=0x16 & k7_7=0x0 & k5_5=0x1 & Maa6 & C5w0 { mv1 = Maa6; build C5w0; }
instr: "movec" C5r0^","^Maa6 is k23_14=0x14 & k7_7=0x0 & k5_5=0x1 & Maa6 & C5r0 { Maa6 = C5r0; }
instr: "movec" R6r8^","^C5w0 is k23_14=0x13 & k7_7=0x1 & k5_5=0x1 & R6r8 & C5w0 { mv1 = R6r8; build C5w0; }
instr: "movec" C5r0^","^R6w8 is k23_14=0x11 & k7_7=0x1 & k5_5=0x1 & C5r0 & R6w8 { mv1 = C5r0; build R6w8; }
instr: "movec" "#<"^k15_8^","^C5w0 is k23_16=0x5 & k7_5=0x5 & k15_8 & C5w0 { mv1 = k15_8; build C5w0; }

# MOVE(M): program memory
instr: "movem" PEA^","^R6w0 is (k23_14=0x1f & k7_6=0x2 & R6w0) ... & PEA { mv1 = PEA; build R6w0; }
instr: "movem" R6r0^","^PEA is (k23_14=0x1d & k7_6=0x2 & R6r0) ... & PEA { PEA = R6r0; }
instr: "movem" Paa^","^R6w0 is k23_14=0x1e & k7_6=0x0 & Paa & R6w0 { mv1 = Paa; build R6w0; }
instr: "movem" R6r0^","^Paa is k23_14=0x1c & k7_6=0x0 & Paa & R6r0 { Paa = R6r0; }

# MOVEP: peripherals
